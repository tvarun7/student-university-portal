PORT=3000
NODE_ENV=development

# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-characters

# PostgreSQL — Required for production on Render
# DATABASE_URL=postgresql://user:password@host/dbname
# DATABASE_SSL=true   # leave unset for Render internal connections
# TRUST_PROXY=1       # required on Render (behind reverse proxy)

# ── AI Study Assistant (Gemini) ───────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
# Then set AI_ENABLED=true and fill in GEMINI_API_KEY below
AI_ENABLED=false
GEMINI_API_KEY=
# Recommended model (free tier supported):
GEMINI_MODEL=gemini-2.0-flash

# ── Admin bootstrap (run once after first deploy) ─────────────────────────────
# BOOTSTRAP_ADMIN_USERNAME=administrator
# BOOTSTRAP_ADMIN_PASSWORD=YourStrongPassword123!
